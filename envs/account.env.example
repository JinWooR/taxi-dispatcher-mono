# ========================================
# account-service 전용 환경변수
# ========================================
# 값은 로컬 환경 기준. 도커 환경에서는 docker-compose.yml의 environment에서 덮어씀.

# DB URL (서비스별 스키마)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/account_db

# JWT 비밀키 (account-service만 토큰 발급)
JWT_PRIVATE_KEY=

# JWT 토큰 만료 시간 (밀리초)
JWT_EXPIRATION_ACCESS=900000
JWT_EXPIRATION_REFRESH=2592000000
