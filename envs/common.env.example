# ========================================
# 공통 환경변수 (모든 서비스 공유)
# ========================================

# Database
# - SPRING_DATASOURCE_URL은 서비스별 env 파일에서 관리 (스키마가 다름)
#   → envs/account.env, envs/user.env, envs/driver.env, envs/dispatcher.env
MYSQL_ROOT_PASSWORD=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# JWT 공개키 (모든 서비스가 토큰 검증에 사용)
JWT_PUBLIC_KEY=

# Internal API Keys (서비스 간 통신에 사용 - 공유 필요)
ACCOUNT_INTERNAL_API_KEY=
USER_INTERNAL_API_KEY=
DRIVER_INTERNAL_API_KEY=
DISPATCHER_INTERNAL_API_KEY=

# CORS 허용 origin (콤마로 구분된 여러 origin 가능)
# - 통합 Swagger UI (http://localhost:8090) 지원
# - 추후 서비스별 다른 정책 필요 시 각 서비스 env로 이관 가능
CORS_ALLOWED_ORIGINS=
